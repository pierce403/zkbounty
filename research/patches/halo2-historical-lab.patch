index 469c19e..e124596 100644
--- a/halo2_gadgets/src/ecc/chip.rs
+++ b/halo2_gadgets/src/ecc/chip.rs
@@ -26,6 +26,79 @@ pub(super) mod witness_point;
 
 pub use constants::*;
 
+#[cfg(feature = "exploit-lab")]
+/// Isolated witness substitution for historical circuit soundness experiments.
+pub mod exploit_lab {
+    use std::cell::RefCell;
+
+    use ff::Field;
+    use group::Curve;
+    use halo2_proofs::circuit::Value;
+    use pasta_curves::pallas;
+
+    use super::mul::{decompose_for_scalar_mul, INCOMPLETE_LEN};
+
+    thread_local! {
+        static REPLACEMENT: RefCell<Option<(pallas::Affine, pallas::Affine, usize)>> = RefCell::new(None);
+    }
+
+    /// Substitute only the unanchored rows for the selected original base.
+    pub fn set(original: pallas::Point, replacement: pallas::Point) {
+        REPLACEMENT.with(|cell| *cell.borrow_mut() = Some((original.to_affine(), replacement.to_affine(), 2)));
+    }
+
+    /// Clear the substitution in this thread.
+    pub fn clear() {
+        REPLACEMENT.with(|cell| *cell.borrow_mut() = None);
+    }
+
+    pub(super) fn replace(original: pallas::Affine) -> pallas::Affine {
+        REPLACEMENT.with(|cell| {
+            let mut entry = cell.borrow_mut();
+            match entry.as_mut() {
+                Some((target, replacement, remaining)) if original == *target && *remaining > 0 => {
+                    *remaining -= 1;
+                    *replacement
+                }
+                _ => original,
+            }
+        })
+    }
+
+    /// Solve the unchanged historical multiplication constraints for the unanchored base.
+    pub fn replacement_for_output(
+        alpha: pallas::Base,
+        original: pallas::Point,
+        desired: pallas::Point,
+    ) -> pallas::Point {
+        let bits = decompose_for_scalar_mul(Value::known(&alpha));
+        let mut q_coefficient = pallas::Scalar::zero();
+        let mut b_coefficient = pallas::Scalar::from(2);
+        for (index, bit) in bits.iter().enumerate() {
+            let mut known = None;
+            bit.assert_if_known(|value| {
+                known = Some(*value);
+                true
+            });
+            let set = known.expect("known alpha");
+            if index < INCOMPLETE_LEN {
+                q_coefficient = q_coefficient.double()
+                    + if set { pallas::Scalar::one() } else { -pallas::Scalar::one() };
+                b_coefficient = b_coefficient.double();
+            } else if index < bits.len() - 1 {
+                q_coefficient = q_coefficient.double();
+                b_coefficient = b_coefficient.double()
+                    + if set { pallas::Scalar::one() } else { -pallas::Scalar::one() };
+            } else if !set {
+                b_coefficient -= pallas::Scalar::one();
+            }
+        }
+        let inverse = Option::<pallas::Scalar>::from(q_coefficient.invert())
+            .expect("nonzero incomplete coefficient");
+        (desired - original * b_coefficient) * inverse
+    }
+}
