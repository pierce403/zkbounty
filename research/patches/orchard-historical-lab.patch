+    #[test]
+    fn adversarial_nullifier_round_trip() {
+        use halo2_gadgets::ecc::chip::exploit_lab;
+        use rand::{rngs::StdRng, SeedableRng};
+        use std::println;
+
+        fn known<T: Clone>(value: Value<T>) -> T {
+            let mut result = None;
+            value.assert_if_known(|value| {
+                result = Some(value.clone());
+                true
+            });
+            result.expect("known test witness")
+        }
+
+        let mut rng = StdRng::seed_from_u64(0x5A_C4_2026);
+        let (_, fvk, dummy) = Note::dummy(&mut rng, None);
+        let spent_note = Note::new(
+            dummy.recipient(),
+            crate::value::NoteValue::from_raw(100_000_000),
+            dummy.rho(),
+            &mut rng,
+        );
+        let path = MerklePath::dummy(&mut rng);
+        let pk = ProvingKey::build();
+        let vk = VerifyingKey::build();
+        let mut nullifiers = Vec::new();
+        for _ in 0..2 {
+            let (circuit, instance) = generate_circuit_instance_with_spend(
+                &mut rng,
+                true,
+                fvk.clone(),
+                spent_note,
+                path.clone(),
+            );
+            assert_eq!(instance.anchor, path.root(spent_note.commitment().into()));
+            assert_eq!(known(circuit.cm_old.clone()).inner(), spent_note.commitment().inner());
+            assert_eq!(known(circuit.v_old).inner(), 100_000_000);
+            assert_eq!(known(circuit.v_new).inner(), 0);
+            assert_eq!(instance.cv_net.to_bytes(), ValueCommitment::derive(
+                spent_note.value() - known(circuit.v_new),
+                known(circuit.rcv.clone()),
+            ).to_bytes());
+            nullifiers.push(instance.nf_old.to_bytes());
+
+            let wrong_nk = known(circuit.nk.clone());
+            let ak = known(circuit.ak.clone());
+            let ak_point: pallas::Point = (&ak).into();
+            let ak_base = crate::spec::extract_p(&ak_point);
+            let rivk = known(circuit.rivk.clone());
+            let ivk = Option::<pallas::Base>::from(crate::spec::commit_ivk(
+                &ak_base,
+                &wrong_nk.inner(),
+                &rivk.inner(),
+            ))
+            .expect("valid adversarial viewing key");
+            let base = *known(circuit.g_d_old.clone());
+            let target = *known(circuit.pk_d_old.clone()).inner();
+            let replacement = exploit_lab::replacement_for_output(ivk, base, target);
+            assert_ne!(replacement, base);
+            exploit_lab::set(base, replacement);
+            let mock = MockProver::run(
+                K,
+                &circuit,
+                instance
+                    .to_halo2_instance()
+                    .iter()
+                    .map(|p| p.to_vec())
+                    .collect(),
+            )
+            .unwrap();
+            if cfg!(feature = "fixed-binding") {
+                assert!(mock.verify().is_err());
+                exploit_lab::clear();
+                continue;
+            }
+            assert_eq!(mock.verify(), Ok(()));
+
+            exploit_lab::set(base, replacement);
+            let proof = Proof::create(&pk, &[circuit], &[instance.clone()], &mut rng).unwrap();
+            assert!(proof.verify(&vk, &[instance]).is_ok());
+            assert_eq!(proof.0.len(), 4992);
+            exploit_lab::clear();
+        }
+        assert_ne!(nullifiers[0], nullifiers[1]);
+        println!("two historical 1 ZEC Action proofs, distinct nullifiers: {:?}", nullifiers);
+    }
