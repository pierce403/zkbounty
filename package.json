{
  "name": "zkbounty-site",
  "version": "0.1.0",
  "private": true,
  "description": "Static project page for the zkbounty research lab",
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "check:deploy": "npm run build && wrangler deploy --dry-run"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "wrangler": "4.149.0"
  }
}
